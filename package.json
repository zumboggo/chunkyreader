{
  "name": "chunky-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:decks": "node scripts/verify-decks.mjs",
    "verify:stories": "node scripts/verify-stories.mjs",
    "generate:audio": "node scripts/generate-azure-reading-clips.mjs",
    "generate:audio:ssml": "node scripts/generate-azure-reading-clips.mjs --ssml-only",
    "generate:word-audio": "node scripts/generate-anna-word-clips.mjs",
    "generate:word-audio:ssml": "node scripts/generate-anna-word-clips.mjs --ssml-only",
    "validate:phonics-audio": "node scripts/validate-phonics-audio.mjs",
    "generate:letter-images": "node scripts/generate-replicate-letter-images.mjs",
    "generate:word-images": "node scripts/generate-replicate-word-images.mjs",
    "generate:word-images:dry": "node scripts/generate-replicate-word-images.mjs --dry-run",
    "generate:word-images:test": "node scripts/generate-replicate-word-images.mjs --limit=5",
    "generate:story-images": "node scripts/generate-story-images.mjs",
    "generate:story-images:dry": "node scripts/generate-story-images.mjs --dry-run",
    "generate:story-images:test": "node scripts/generate-story-images.mjs --limit 2"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
