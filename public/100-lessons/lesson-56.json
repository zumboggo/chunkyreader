      "audioPaths": [
        "audio/lesson-56_c8_i0_that-tiger-was-going.mp3"
      ]
    },
    {
      "type": "story",
      "items": [
        "The little white eagle was under the fat eagle's tree."
      ],
      "audioPaths": [
        "audio/lesson-56_c9_i0_the-little-white-eag.mp3"
      ]
    },
    {
      "type": "story",
      "items": [
        "The other eagles yelled, but the little white eagle did not hear them."
      ],
      "audioPaths": [
        "audio/lesson-56_c10_i0_the-other-eagles-yel.mp3"
      ]
    },
    {
      "type": "story",
      "items": [
