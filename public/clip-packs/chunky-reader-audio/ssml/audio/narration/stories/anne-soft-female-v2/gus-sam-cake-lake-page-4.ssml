<?xml version="1.0" encoding="utf-8"?>
<speak version="1.0" xml:lang="en-US" xmlns="http://www.w3.org/2001/10/synthesis">
  <voice name="en-US-JennyNeural">
    <prosody rate="-8%" pitch="+2%">
      Sam hissed, ?You have jam on the tip of your chin!<break time="350ms"/>And crumbs on your coat! And a grinny-goat grin!?<break time="350ms"/>Gus said, ?That is oat-jam. I eat it with tea.<break time="350ms"/>Your cake was not taken by goatish old me!?
    </prosody>
  </voice>
</speak>
