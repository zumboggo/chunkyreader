<?xml version="1.0" encoding="utf-8"?>
<speak version="1.0" xml:lang="en-US" xmlns="http://www.w3.org/2001/10/synthesis">
  <voice name="en-US-JennyNeural">
    <prosody rate="-8%" pitch="+2%">
      So Gus and Sam followed Pip down the track,<break time="350ms"/>Past a thin little twig and a thick muddy stack.<break time="350ms"/>They passed a fish with a fin in a dish,<break time="350ms"/>And a frog on a log making one birthday wish.
    </prosody>
  </voice>
</speak>
