<?xml version="1.0" encoding="utf-8"?>
<speak version="1.0" xml:lang="en-US" xmlns="http://www.w3.org/2001/10/synthesis">
  <voice name="en-US-JennyNeural">
    <prosody rate="-8%" pitch="+2%">
      So Sam cut the cake with a chop and a chat,<break time="350ms"/>And Ben put a plate on the top of his hat.<break time="350ms"/>Gus got a slice with a spoon and a tune,<break time="350ms"/>And Pip got a piece shaped like half of the moon.
    </prosody>
  </voice>
</speak>
