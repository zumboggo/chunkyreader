<?xml version="1.0" encoding="utf-8"?>
<speak version="1.0" xml:lang="en-US" xmlns="http://www.w3.org/2001/10/synthesis">
  <voice name="en-US-JennyNeural">
    <prosody rate="-8%" pitch="+2%">
      Pip looked at the mud.<break time="350ms"/>Pip looked at the grass.<break time="350ms"/>Pip looked through a round little looking-glass.<break time="350ms"/>?There are marks by the path, and a print by the well.<break time="350ms"/>And something smells sweet. I can follow that smell.?
    </prosody>
  </voice>
</speak>
