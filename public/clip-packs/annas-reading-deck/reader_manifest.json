  "imagePathPattern": "images/{word-slug}.png",
  "audioPathPattern": "audio/words/anne-soft-female-v2/{word}.mp3",
  "optionalCardFields": [
    "image",
    "audio",
    "exampleSentence",
    "category",
    "difficulty"
  ]
}
